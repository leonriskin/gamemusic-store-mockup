{
  "name": "gamemusic-store-mockup",
  "private": true,
  "scripts": {
    "dev": "node scripts/restore-local-redirects.mjs && netlify dev",
    "dev:static": "powershell -NoProfile -ExecutionPolicy Bypass -File start-server.ps1",
    "restore:redirects": "node scripts/restore-local-redirects.mjs",
    "upload:r2": "node scripts/upload-r2.mjs",
    "upload:r2:force": "node scripts/upload-r2.mjs --force",
    "install:hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-git-hooks.ps1",
    "prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-git-hooks.ps1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "netlify-cli": "^23.15.0",
    "wrangler": "^4.114.0"
  }
