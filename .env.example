# Cloudflare R2 — copy to .env and fill in (never commit .env)
# Dashboard → R2 → Manage R2 API Tokens (Object Read & Write on bucket riskin-tracks)

R2_ACCOUNT_ID=90f505deba234410dfcef0f5a4b880f8
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=riskin-tracks
# Public URL for the bucket (custom domain or r2.dev)
R2_PUBLIC_BASE_URL=https://pub-45a1df6488174a1a84baf1ed003ac6dd.r2.dev

# --- Automatic uploads (no manual scripts) ---
#
# Local (Windows): git push runs .githooks/pre-push → syncs tracks/* to R2.
#   One-time setup: npm install  (runs scripts/install-git-hooks.ps1)
#   Auth option A: npx wrangler login  (OAuth — already works for ionicsmusic2017@gmail.com)
#   Auth option B: fill R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY above (faster skip-existing via S3 HeadObject)
#   Skip upload once: SKIP_R2_UPLOAD=1 git push
#   Manual: npm run upload:r2
#
# GitHub Actions (.github/workflows/r2-upload.yml): uploads catalog JSON when it changes.
#   Add repo secrets (Settings → Secrets and variables → Actions):
#     R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
#   Optional secrets: R2_BUCKET, R2_PUBLIC_BASE_URL
#
# Track media (.mp3, .zip, cover.jpg) is NOT stored on GitHub — only on your disk + R2.
# catalog.json and track-meta.json stay in git and are also synced to R2.

# --- Contact form (Resend + Netlify Functions) ---
#
# Local: copy to .env and fill RESEND_API_KEY, then npm run dev.
# Production: Netlify → Site settings → Environment variables (same names).
#
RESEND_API_KEY=
CONTACT_TO=ionicsmusic2017@gmail.com
RESEND_FROM=Riskin Tracks <onboarding@resend.dev>
# Test sender onboarding@resend.dev only delivers to your Resend signup email.
# Production: verify riskintracks.com in Resend, then e.g. contact@riskintracks.com

# --- Waitlist / newsletter (under-construction page) ---
#
# Form posts to /.netlify/functions/waitlist → Resend welcome email + Contacts/Audience.
# WAITLIST_AUDIENCE_ID is optional (Resend Audience or Segment id). Without it,
# signup still works: welcome email sends; contact create is best-effort / logged.
#
# Welcome email includes List-Unsubscribe headers + a visible Unsubscribe footer.
# Clicking it hits /.netlify/functions/waitlist-unsubscribe?email=… which marks
# the Resend contact unsubscribed (PATCH /contacts/{email}).
#
# Base URL for unsubscribe links (local preview / production):
#   Prefer SITE_URL; else request Host; else https://riskintracks.com
# Netlify also sets URL automatically in deployed functions.
SITE_URL=https://riskintracks.com
# Optional From override for waitlist mail (falls back to RESEND_FROM):
WAITLIST_FROM=
# Resend Audience (legacy) or Segment id — leave blank until you create one:
WAITLIST_AUDIENCE_ID=
# Absolute HTTPS URL for the Founders Loop Pack zip in the welcome email.
# Default: ${R2_PUBLIC_BASE_URL}/packs/founders-loop-pack.zip
# Upload the zip to R2 at key packs/founders-loop-pack.zip (or set this override).
WAITLIST_FOUNDERS_PACK_URL=https://pub-45a1df6488174a1a84baf1ed003ac6dd.r2.dev/packs/founders-loop-pack.zip
# Logo in welcome email (absolute HTTPS; default production asset):
# WAITLIST_LOGO_URL=https://riskintracks.com/assets/riskin-tracks-logo-header.png

# --- Newsletter admin (Admin → Newsletter, localhost / Netlify Dev) ---
#
# Compose + preview + send waitlist newsletters via Resend Broadcasts.
# Requires npm run dev (NETLIFY_DEV=true). APIs refuse production unless
# ADMIN_NEWSLETTER_SECRET is set and the client sends matching header
# X-Admin-Newsletter-Secret (prevents open relay).
#
# Broadcast send needs WAITLIST_AUDIENCE_ID (Resend Audience or Segment) —
# "Send to all waitlist subscribers" goes to everyone in that audience.
# Without it you can still Preview and send a single testEmail.
# Scheduled sends: data/newsletter-schedule.json + Admin poll while Newsletter
# page is open. Production offline delivery needs a cron / scheduled function.
# Optional: SITE_LIVE=true makes Listen links point at SITE_URL instead of
# the R2 demo.mp3 URL (default = construction / R2 demo links).
#
ADMIN_NEWSLETTER_SECRET=
# SITE_LIVE=false

# --- PayPal checkout (Netlify Functions) ---
#
# Developer Dashboard → Apps & Credentials → create REST API app → Sandbox tab.
# Client ID is exposed to the browser via /.netlify/functions/paypal-config.
# Client Secret must stay server-side only (Netlify env + local .env).
#
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Use live credentials and PAYPAL_MODE=live when ready for real payments.

# --- Stripe card checkout (Netlify Functions + Payment Element) ---
#
# Dashboard → Developers → API keys (use Test mode keys first).
# Publishable key is exposed via /.netlify/functions/stripe-config.
# Secret key must stay server-side only (Netlify env + local .env).
#
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Test card: 4242 4242 4242 4242 · any future expiry · any 3-digit CVC
# Production: switch to live keys (pk_live_… / sk_live_…) in Netlify env vars.
